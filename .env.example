# PHP and Node.js use the same MySQL database. Set these in your local environment.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=society_management
DB_USER=root
DB_PASSWORD=

# Node.js API settings (copy node-backend/.env.example to node-backend/.env)
PORT=3001
INTERNAL_API_KEY=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost
